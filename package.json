  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "serve": "python3 -m http.server 8000",
    "test": "echo \"No tests yet - contribute!\"",
    "dev": "python3 -m http.server 8000 --directory .",
    "lint": "echo \"Add ESLint configuration\"",
    "build": "echo \"Single-file app - no build needed\"",
    "deploy": "git push origin main"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/[YOUR-USERNAME]/binance-it-together.git"
  },
